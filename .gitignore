# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw publisher source assets (see scripts/prepare-images.mjs). PSD sources
# and misc extras are never committed; the flattened JPGs under files/*/JPG
# and logos/ ARE tracked as the git backup for the (much larger) PSDs.
/MyCatIsAVegtarianCHRAW/**/*.psd
/MyCatIsAVegtarianCHRAW/KO2EN/aboutTheWork/
/MyCatIsAVegtarianCHRAW/KO2EN/sheets/

# generated by scripts/check-missing-chapters.mjs
/scripts/missing-report.txt
